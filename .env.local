# Local development environment (use this when running on your laptop)
# Copy to .env or `set -a && source .env.local && set +a` before running scripts

GALACTUS_PROJECT_ROOT=/media/sandeep/DataDrive/galactus
GALACTUS_DATA_ROOT=/tmp/galactus
HUDI_BASE_PATH=/tmp/galactus/silver
GALACTUS_TEMP_DIR=/tmp/galactus_temp
GALACTUS_LOG_DIR=/tmp/galactus/logs

# Spark and Python - prefer a PySpark-compatible interpreter (3.10/3.11)
SPARK_SUBMIT_PATH=spark-submit
PYSPARK_PYTHON=/usr/bin/python3.10
PYSPARK_DRIVER_PYTHON=$PYSPARK_PYTHON

# ClickHouse (local dev - may be dockerized)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=galactus
CLICKHOUSE_USER=default

# Spark settings tuned for local dev
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g
