# Galactus Environment Configuration

# Core Service Configuration
GALACTUS_ENV=production
RUST_LOG=info
GALACTUS_METRICS_ENABLED=true

# API Configuration
GALACTUS_HTTP_PORT=8080
GALACTUS_GRPC_PORT=9090

# Database Configuration (Future)
DATABASE_URL=postgresql://user:password@postgres:5432/postgres
DATABASE_MAX_CONNECTIONS=10

# Monitoring Configuration
PROMETHEUS_RETENTION_TIME=720h
# IMPORTANT: Change this password before deployment!
GRAFANA_ADMIN_PASSWORD=changeme

# Security Configuration
# IMPORTANT: Generate strong secrets before deployment!
JWT_SECRET=your-secret-key-here
API_KEY=your-api-key-here

# Feature Flags
GALACTUS_ENABLE_EXPERIMENTAL_FEATURES=false
GALACTUS_ENABLE_DEBUG_LOGGING=false

# Resource Limits
GALACTUS_MAX_WORKERS=4
GALACTUS_MEMORY_LIMIT_MB=1024

# External Services
# REDIS_URL=redis://redis:6379
# KAFKA_BROKERS=kafka:9092
