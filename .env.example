# Galactus Environment Configuration
# Copy this file to .env and update with your settings

# =============================================================================
# Data Storage Paths
# =============================================================================

# Project root directory (defaults to current directory)
GALACTUS_PROJECT_ROOT=/path/to/galactus

# Base path for all data storage (Bronze/Silver/Gold)
GALACTUS_DATA_ROOT=/path/to/galactus/data

# Hudi tables location (Silver layer)
HUDI_BASE_PATH=/path/to/galactus/data/silver

# Temporary storage directory
GALACTUS_TEMP_DIR=/tmp/galactus

# =============================================================================
# Logging Configuration
# =============================================================================

# Log directory
GALACTUS_LOG_DIR=/path/to/galactus/logs

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
GALACTUS_LOG_LEVEL=INFO

# =============================================================================
# ClickHouse Configuration
# =============================================================================

# ClickHouse server host
CLICKHOUSE_HOST=localhost

# ClickHouse server port
CLICKHOUSE_PORT=8123

# ClickHouse database name
CLICKHOUSE_DATABASE=galactus

# ClickHouse username
CLICKHOUSE_USER=default

# ClickHouse password (leave empty if no password)
CLICKHOUSE_PASSWORD=

# =============================================================================
# Hive Metastore Configuration (Optional)
# =============================================================================

# Hive Metastore URI
HIVE_METASTORE_URI=thrift://localhost:9083

# =============================================================================
# Spark Configuration
# =============================================================================

# Spark master URL
SPARK_MASTER=local[*]

# Spark driver memory
SPARK_DRIVER_MEMORY=4g

# Spark executor memory
SPARK_EXECUTOR_MEMORY=4g

# =============================================================================
# Kafka Configuration
# =============================================================================

# Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka security protocol
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Kafka SASL mechanism (leave empty if not using SASL)
KAFKA_SASL_MECHANISM=

# Kafka SASL username (leave empty if not using SASL)
KAFKA_SASL_USERNAME=

# Kafka SASL password (leave empty if not using SASL)
KAFKA_SASL_PASSWORD=

# =============================================================================
# NSE Scraping Configuration
# =============================================================================

# HTTP request timeout in seconds
NSE_DOWNLOAD_TIMEOUT=30

# Number of retry attempts on failure
NSE_RETRY_ATTEMPTS=3

# Delay between retries in seconds
NSE_RETRY_DELAY=5

# =============================================================================
# Notes
# =============================================================================

# Docker Users:
# - Most paths are set automatically in the container
# - Override CLICKHOUSE_HOST to 'clickhouse' for docker-compose
# - No need to set GALACTUS_PROJECT_ROOT in Docker

# Kubernetes Users:
# - Use ConfigMaps and Secrets for configuration
# - See k8s/configmap.yaml for available settings
# - Paths are preset in k8s/deployment.yaml

# Development:
# - Use local[*] for SPARK_MASTER for single-machine development
# - Set GALACTUS_LOG_LEVEL=DEBUG for detailed logs
# - Adjust memory settings based on your machine capacity
