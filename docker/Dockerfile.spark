# Dockerfile for Spark
FROM apache/spark:3.5.0

# Install additional packages
USER root
RUN apt-get update && apt-get install -y \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY src/ /opt/spark/src/
COPY config/ /opt/spark/config/

# Set PYTHONPATH
ENV PYTHONPATH=/opt/spark/src:/opt/spark/config:$PYTHONPATH

# Download ClickHouse JDBC driver
RUN wget -P /opt/spark/jars/ https://repo1.maven.org/maven2/com/clickhouse/clickhouse-jdbc/0.6.3/clickhouse-jdbc-0.6.3.jar

# Switch back to spark user
USER spark