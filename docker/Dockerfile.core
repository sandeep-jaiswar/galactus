# Multi-stage build for Galactus Core
FROM rust:1.85-slim AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy the entire Rust project
COPY core/rust/ ./

# Build the application
RUN cargo build --release --bin galactus-http-server

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --shell /bin/bash galactus

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/galactus-http-server /app/galactus-core

# Copy configuration files
COPY core/rust/config ./config

# Change ownership
RUN chown -R galactus:galactus /app

# Switch to non-root user
USER galactus

# Expose ports
EXPOSE 8080 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/api/v1/health || exit 1

# Run the application
CMD ["./galactus-core"]