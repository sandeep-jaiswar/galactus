# Kubernetes / production environment (example values for k8s manifests)
# Use ConfigMaps and Secrets in k8s; this file documents recommended defaults.

GALACTUS_PROJECT_ROOT=/app
GALACTUS_DATA_ROOT=/data
HUDI_BASE_PATH=/data/silver
GALACTUS_TEMP_DIR=/tmp/galactus
GALACTUS_LOG_DIR=/var/log/galactus

# In k8s, the Python runtime is controlled by the container image
SPARK_SUBMIT_PATH=/opt/spark/bin/spark-submit
PYSPARK_PYTHON=/usr/bin/python3
PYSPARK_DRIVER_PYTHON=$PYSPARK_PYTHON

# ClickHouse service name in k8s (replace with your service name)
CLICKHOUSE_HOST=clickhouse-service
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=galactus
CLICKHOUSE_USER=galactus_user

# HIVE_METASTORE_URI should point to real metastore in prod
HIVE_METASTORE_URI=thrift://metastore:9083

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Spark production settings (tune per cluster)
SPARK_MASTER=yarn
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=8g
