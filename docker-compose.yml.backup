services:
  galactus:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: galactus-app
    environment:
      - GALACTUS_PROJECT_ROOT=/app
      - GALACTUS_DATA_ROOT=/app/data
      - GALACTUS_LOG_DIR=/app/logs
      - GALACTUS_LOG_LEVEL=INFO
      - HUDI_BASE_PATH=/app/data/silver
      - SPARK_MASTER=local[*]
      - SPARK_DRIVER_MEMORY=2g
      - SPARK_EXECUTOR_MEMORY=2g
      - CLICKHOUSE_HOST=clickhouse
      - CLICKHOUSE_PORT=8123
      - CLICKHOUSE_DATABASE=galactus
      - KAFKA_BOOTSTRAP_SERVERS=kafka:29092
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
      - ./jobs:/app/jobs
      - ./utils:/app/utils
      - ./conf:/app/conf
    depends_on:
      clickhouse:
        condition: service_started
      kafka:
        condition: service_healthy
    networks:
      - galactus-network
    command: >
      bash -c "
        echo 'Waiting for Kafka to be ready...' &&
        python -c '
        import socket
        import time
        import sys
        host, port = \"kafka\", 29092
        for i in range(60):
            try:        import socket
        import time
        import sys
        host, port = \"kafka\", 29092
        for i in range(60):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1)
                result = sock.connect_ex((host, port))
                sock.close()
                if result == 0:
                    print(\"Kafka is ready!\")
                    sys.exit(0)
            except:
                pass
            print(f\"Waiting for Kafka... ({i+1}/60)\")
            time.sleep(2)
        print(\"Timeout waiting for Kafka\")
        sys.exit(1)
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1)
                result = sock.connect_ex((host, port))
                sock.close()
                if result == 0:
                    print(\"Kafka is ready!\")
                    sys.exit(0)
            except:
                pass
            print(f\"Waiting for Kafka... ({i+1}/60)\")
            time.sleep(2)
        print(\"Timeout waiting for Kafka\")
        sys.exit(1)
        ' &&
        echo 'Creating topics...' &&
        python utils/create_kafka_topics.py &&
        echo 'Topics created. Starting application...' &&
        tail -f /dev/null
      "

  # Zookeeper for Kafka
  zookeeper:
    image: confluentinc/cp-zookeeper:7.4.0
    container_name: galactus-zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    healthcheck:
      test: ["CMD-SHELL", "echo 'ruok' | nc localhost 2181"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - galactus-network

  # Kafka broker
  kafka:
    image: confluentinc/cp-kafka:7.4.0
    container_name: galactus-kafka
    depends_on:
      zookeeper:
        condition: service_healthy
    ports:
      - "9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,PLAINTEXT_INTERNAL://0.0.0.0:29092
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,PLAINTEXT_INTERNAL:PLAINTEXT
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka:29092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "kafka-broker-api-versions --bootstrap-server localhost:9092",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - galactus-network

  # ClickHouse for analytics
  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: galactus-clickhouse
    environment:
      - CLICKHOUSE_DB=galactus
      - CLICKHOUSE_USER=default
      - CLICKHOUSE_PASSWORD=galactus
    ports:
      - "8124:8123"
      - "9001:9000"
    volumes:
      - clickhouse-data:/var/lib/clickhouse
      - clickhouse-logs:/var/log/clickhouse-server
    networks:
      - galactus-network

  metastore:
    image: apache/hive:3.1.3
    container_name: galactus-metastore
    environment:
      - SERVICE_NAME=metastore
    ports:
      - "9083:9083"
    networks:
      - galactus-network

volumes:
  clickhouse-data:
  clickhouse-logs:

networks:
  galactus-network:
    driver: bridge
