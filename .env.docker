# Docker development environment (used by docker-compose)
# These settings mirror values in docker-compose.yml and Dockerfile

GALACTUS_PROJECT_ROOT=/app
GALACTUS_DATA_ROOT=/app/data
HUDI_BASE_PATH=/app/data/silver
GALACTUS_TEMP_DIR=/tmp/galactus
GALACTUS_LOG_DIR=/app/logs

# Inside container Python path - container installs system python
SPARK_SUBMIT_PATH=/opt/spark/bin/spark-submit
PYSPARK_PYTHON=/usr/bin/python3
PYSPARK_DRIVER_PYTHON=$PYSPARK_PYTHON

# ClickHouse service inside docker-compose
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=galactus
CLICKHOUSE_USER=default

# Kafka service inside docker-compose
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Spark settings (container)
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
